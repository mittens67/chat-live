# Copy to .env and fill in. Never commit the real .env.
#   cp .env.example .env

# Port the API server listens on.
PORT=3000

# MongoDB connection string.
# Local (via `docker compose up -d`):
MONGO_URI=mongodb://localhost:27017/chat-live
# Hosted (MongoDB Atlas) looks like:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chat-live?retryWrites=true&w=majority

# Secret used to sign JWTs. Generate a strong random value:
#   openssl rand -hex 32
# Anyone who knows this can forge a token for any account.
JWT_SECRET=

# "development" or "production".
# In production the server also serves the built client from client/dist.
NODE_ENV=development

# Origin allowed to call the API cross-origin (dev: the Vite dev server).
# In production the client is served same-origin, so this can be left unset.
CORS_ORIGIN=http://localhost:5173

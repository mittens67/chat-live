# Copy to .env and fill in. Vite only exposes vars prefixed with VITE_.
#   cp .env.example .env
# Everything here ships to the browser — never put a secret in this file.
#
# Both values below are optional. Without Cloudinary the app runs fine;
# attachment uploads simply report that they are not configured.

# Origin of the Socket.io server. Leave blank for same-origin, which is correct
# both in production (Express serves the client) and in development (the Vite
# dev server proxies /socket.io through to the API).
# Only set this if the API is on a different host.
VITE_SOCKET_URL=

# Cloudinary unsigned upload, used for avatars and chat attachments.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
